#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

SKIP_MISSING="false"
FIX="false"

usage() {
    cat <<'EOF'
Usage: bin/check [--skip-missing] [--fix]

Runs shell syntax/style checks, application config validation, and an isolated
Chezmoi apply/idempotence test.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --skip-missing)
            SKIP_MISSING="true"
            shift
            ;;
        --fix)
            FIX="true"
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            printf 'Unknown argument: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

fail() {
    printf 'FAIL %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'WARN %s\n' "$*"
}

require_cmd() {
    local command_name="$1"
    if ! command -v "$command_name" >/dev/null 2>&1; then
        if [[ "$SKIP_MISSING" == "true" ]]; then
            warn "Missing $command_name; skipping its check."
            return 1
        fi
        fail "Missing $command_name. Check Brewfile and run: dot packages apply"
    fi
}

run() {
    printf '+'
    printf ' %q' "$@"
    printf '\n'
    "$@"
}

shopt -s nullglob

BASH_FILES=(
    bootstrap.sh
    bin/*
    macos/*.sh
    home/dot_bash_profile
    home/dot_bashrc
    home/private_dot_config/shell/functions.sh
)

ZSH_FILES=(
    home/dot_zshenv
    home/dot_zprofile
    home/dot_zshrc
    home/private_dot_config/shell/functions.sh
)

SH_FILES=(
    home/private_dot_config/shell/aliases.sh
    home/private_dot_config/shell/env.sh
    home/private_dot_config/shell/interactive.sh
)

printf '== Syntax\n'
run bash -n "${BASH_FILES[@]}"
run zsh -n "${ZSH_FILES[@]}"
run sh -n "${SH_FILES[@]}"

printf '\n== Shellcheck\n'
if require_cmd shellcheck; then
    run shellcheck -e SC1091 "${BASH_FILES[@]}" "${SH_FILES[@]}"
fi

printf '\n== shfmt\n'
if require_cmd shfmt; then
    if [[ "$FIX" == "true" ]]; then
        run shfmt -w -i 4 -ci -bn "${BASH_FILES[@]}" "${SH_FILES[@]}"
    else
        run shfmt -d -i 4 -ci -bn "${BASH_FILES[@]}" "${SH_FILES[@]}"
    fi
fi

printf '\n== Keystone PATH handoff\n'
expected_keystone_tail="$(printf '%s\n' \
    '# >>> kstoolchain managed bin >>>' \
    "export PATH=\"\$HOME/.keystone/toolchain/active/bin:\$PATH\"" \
    '# <<< kstoolchain managed bin <<<')"
actual_keystone_tail="$(tail -n 3 "$ROOT_DIR/home/dot_zshrc")"
if [[ "$actual_keystone_tail" != "$expected_keystone_tail" ]]; then
    fail "kstoolchain managed PATH block must be the final three lines of home/dot_zshrc"
fi

printf '\n== Starship\n'
if require_cmd starship; then
    STARSHIP_CONFIG="$ROOT_DIR/home/private_dot_config/starship.toml" run starship print-config >/dev/null
fi

printf '\n== Ghostty\n'
if require_cmd ghostty; then
    run ghostty +validate-config --config-file="$ROOT_DIR/home/private_dot_config/ghostty/config"
fi

printf '\n== Finder Quick Actions\n'
if [[ "$(uname -s)" == "Darwin" ]] && require_cmd plutil; then
    run plutil -lint "$ROOT_DIR/home/private_Library/private_Services/Copy Path.workflow/Contents/Info.plist"
    run plutil -lint "$ROOT_DIR/home/private_Library/private_Services/Copy Path.workflow/Contents/Resources/document.wflow"
fi
expected_copy_path="$(printf '\176/selected file\n/etc/hosts')"
actual_copy_path="$(
    COPY_PATH_CLIPBOARD_COMMAND=/bin/cat \
        "$ROOT_DIR/bin/copy-path" "$HOME/selected file" /etc/hosts
)"
if [[ "$actual_copy_path" != "$expected_copy_path" ]]; then
    fail "copy-path did not contract the home directory correctly"
fi

printf '\n== Storage report\n'
storage_output="$("$ROOT_DIR/bin/dot" storage --home "$ROOT_DIR")"
if [[ "$storage_output" != *"floor       ok:"* || "$storage_output" != *"Known high-growth locations"* ]]; then
    fail "storage report omitted its safety floor or growth inventory"
fi

printf '\n== Chezmoi isolated home\n'
if require_cmd chezmoi; then
    run "$ROOT_DIR/bin/test-chezmoi"
fi

printf '\nAll checks passed.\n'
