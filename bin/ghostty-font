#!/usr/bin/env bash
set -euo pipefail

# Switch the machine-local Ghostty font override by time or explicit argument.
# The managed base config stays unchanged, so Chezmoi remains convergent.

GHOSTTY_LOCAL_CONFIG="${GHOSTTY_LOCAL_CONFIG:-$HOME/.config/ghostty/local}"

usage() {
    cat <<'EOF'
Usage: ghostty-font [thin|light|auto]

  thin   - Set font-style to Thin
  light  - Set font-style to Light
  auto   - Thin from 18:30-05:30 CT, Light otherwise (default)
EOF
}

pick_style() {
    local hour minute
    hour=$(TZ="America/Chicago" date +%H)
    minute=$(TZ="America/Chicago" date +%M)
    local time_val=$((10#$hour * 60 + 10#$minute))

    # Thin: 18:30 (1110) to 05:30 (330)
    if [[ $time_val -ge 1110 || $time_val -lt 330 ]]; then
        echo "Thin"
    else
        echo "Light"
    fi
}

set_style() {
    local style="$1"
    local config_dir=""
    local temp_file=""

    config_dir="$(dirname "$GHOSTTY_LOCAL_CONFIG")"
    mkdir -p "$config_dir"
    temp_file="$(mktemp "$config_dir/.ghostty-local.XXXXXX")"

    if [[ -f "$GHOSTTY_LOCAL_CONFIG" ]]; then
        awk '
            /^[[:space:]]*font-style[[:space:]]*=/ { next }
            { print }
        ' "$GHOSTTY_LOCAL_CONFIG" >"$temp_file"
    else
        printf '%s\n' '# Machine-local Ghostty overrides; intentionally unmanaged.' >"$temp_file"
    fi

    {
        printf '\n'
        printf 'font-style = %s\n' "$style"
    } >>"$temp_file"
    mv "$temp_file" "$GHOSTTY_LOCAL_CONFIG"
}

mode="${1:-auto}"

case "$mode" in
    thin) set_style "Thin" ;;
    light) set_style "Light" ;;
    auto) set_style "$(pick_style)" ;;
    -h | --help) usage ;;
    *)
        echo "Unknown argument: $mode" >&2
        usage >&2
        exit 2
        ;;
esac
