# Vim files
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist
*~

# Vagrant files
vagrant/*.log
vagrant/.vagrant/

# Don't check in passwords
.secrets
openai.token

# macOS
.DS_Store

# Never capture machine-local overlays in Chezmoi source state.
home/private_dot_config/ghostty/local
home/private_dot_config/git/local
home/private_dot_config/shell/local.sh
home/private_dot_config/workspaces/local/
home/private_dot_ssh/config.d/

# Claude Code - track hooks and settings, ignore local data
.claude/*
!.claude/hooks/
!.claude/settings.json
**/.claude/settings.local.json

# Homebrew Bundle
Brewfile.lock.json
.keystone/local/
.keystone/branch-lineage/
.keystone/lock
.keystone/*.lock
